# Copy to deploy/compose/.env and replace every value marked "replace".
# Generate hex secrets to keep DATABASE_URL parsing predictable:
#   openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-64-hex-characters
BETTER_AUTH_SECRET=replace-with-a-different-64-hex-secret
BETTER_AUTH_URL=https://notify.example.com

# Image/build identity shown by /api/health.
APP_VERSION=selfhost
ALPHORN_IMAGE=alphorn-local
ALPHORN_PORT=3000

# Runtime tuning.
MODE=all
WORKER_CONCURRENCY=20
DATABASE_POOL_SIZE=10
LOG_LEVEL=info
BETTER_AUTH_LOG_LEVEL=warn
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_MAX_HOPS=3
SSE_MAX_CONNECTIONS_PER_CHANNEL=20
SSE_MAX_CONNECTIONS_PER_IP=20

# Optional system email for verification, password reset, and invitations.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Sentry-compatible error tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Tunnel only. Create a remotely managed tunnel, then paste its
# connector token here. Never commit deploy/compose/.env.
CLOUDFLARED_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Pinned Stripe Smokescreen source revision used by the production build.
SMOKESCREEN_REF=f03c477dc9f4fe3252ae96ad9274d53108b2c53c
SMOKESCREEN_IMAGE_TAG=f03c477d
# Smokescreen resolves destination hostnames itself. Override these only if
# your environment requires different reachable recursive resolvers.
SMOKESCREEN_DNS_PRIMARY=1.1.1.1
SMOKESCREEN_DNS_SECONDARY=1.0.0.1
